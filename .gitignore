/*.gkyl
/*.md
/*.py
!/setup.py
/*.json
# built gpython/_gpython extension (scripts/build_gpython.sh)
src/postgkyl/gpython/_gpython.so

# scratch output from running examples/scripts/*.py directly
examples/scripts/output/
.vscode/settings.json
.coverage